# ─── Database ───────────────────────────────────────────────
# PostgreSQL (production — required on Vercel)
DATABASE_URL="postgresql://user:password@host:5432/quicksilver_algo?schema=public"
# SQLite (local dev only)
# DATABASE_URL="file:./dev.db"

# ─── Authentication ─────────────────────────────────────────
# Session signing secret (required in production)
NEXTAUTH_SECRET="change-this-to-a-secure-random-string-in-production"
# Legacy alias — either NEXTAUTH_SECRET or JWT_SECRET is accepted
# JWT_SECRET="change-this-to-a-secure-random-string-in-production"

# ─── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Premium subscription ($149.99/mo) — required for webhook tier sync
STRIPE_PRICE_ID_PREMIUM="price_..."
# Legacy price IDs (optional — mapped to Premium for existing subscribers)
# STRIPE_PRICE_ID_TIER_1="price_..."
# STRIPE_PRICE_ID_TIER_2="price_..."
# STRIPE_PRICE_ID_TIER_3="price_..."
# Promo reference (FIRST100 — $60 off first month, first 100 users)
# STRIPE_PROMO_ID_FIRST100="promo_1TlzBjDUxwVQyisqks4CyIKy"

# ─── Partner Links ──────────────────────────────────────────
HEROFX_PARTNER_LINK="https://herofx.co/?partner_code=9149459"

# ─── Application ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_SITE_URL="https://quicksilveralgo.com"

NEXT_PUBLIC_GA_MEASUREMENT_ID="G-QGV9HDNZ2E"
ADMIN_EMAIL="admin@yourdomain.com"

# ─── Transactional Email (Resend) ───────────────────────────
# Create key at https://resend.com/api-keys — never commit the real key
RESEND_API_KEY=""
# Must use a verified domain (https://resend.com/domains). Not onboarding@resend.dev.
RESEND_FROM_EMAIL="Quicksilver Algo <onboarding@quicksilveralgo.com>"
# Support replies (must be on verified domain)
# RESEND_SUPPORT_FROM="Quicksilver Support <supportteam@quicksilveralgo.com>"
# SUPPORT_EMAIL="supportteam@quicksilveralgo.com"
# Do not set SUPPORT_EMAIL or RESEND_REPLY_TO to support@ until that inbox is connected.
# Optional default reply-to for marketing emails
# RESEND_REPLY_TO="supportteam@quicksilveralgo.com"
# Resend webhook signing secret (Webhooks → email.received)
# RESEND_WEBHOOK_SECRET="whsec_..."
# Shared secret for cron routes (playbook drip, engagement drip)
ONBOARDING_INTERNAL_SECRET=""

# ─── Market Data (live feeds — falls back to mock if unset) ───
# Twelve Data: XAUUSD, XAGUSD, NAS100, BTC prices, candles, ATR
TWELVE_DATA_API_KEY=""
# Finnhub: economic calendar, forex/general news, sentiment scoring
FINNHUB_API_KEY=""
