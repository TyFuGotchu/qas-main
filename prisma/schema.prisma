generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  TIER_1
  TIER_2
  LIFETIME
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  name               String?
  passwordHash       String
  subscriptionTier   SubscriptionTier @default(FREE)
  accountTier        String         @default("Free")
  isAdmin            Boolean        @default(false)
  onboardingComplete Boolean        @default(false)
  stripeCustomerId   String?
  stripePriceId      String?
  stripeSessionId    String?
  /// Unique share code for invite links (?ref=CODE)
  referralCode       String?        @unique
  /// User who referred this account (set at register only)
  referredById       String?
  referredBy         User?          @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          User[]         @relation("UserReferrals")
  /// Spendable promotional Premium credit in cents (unlocked referral rewards)
  referralCreditCents Int           @default(0)
  paypalEmail        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  sessions           Session[]
  announcements      Announcement[]
  forumThreads         ForumThread[]
  forumMessages        ForumMessage[]
  onboardingEmailLogs    OnboardingEmailLog[]
  playbookProgress       PropFirmPlaybookProgress?
  playbookEmailLogs      PlaybookEmailLog[]
  traderProfile          TraderProfile?
  journalEntries         TradeJournalEntry[]
  referralRewardsEarned  ReferralReward[] @relation("ReferrerRewards")
  referralRewardAsReferred ReferralReward? @relation("ReferredReward")
  referralPayouts        ReferralPayoutRequest[]
}

// $5 promotional credit when a referred user becomes paid Premium.
// status: pending | available | applied_to_premium | cashed_out | clawed_back
model ReferralReward {
  id              String   @id @default(cuid())
  referrerId      String
  referrer        User     @relation("ReferrerRewards", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId  String   @unique
  referredUser    User     @relation("ReferredReward", fields: [referredUserId], references: [id], onDelete: Cascade)
  amountCents     Int      @default(500)
  status          String   @default("pending")
  availableAt     DateTime
  unlockedAt      DateTime?
  appliedAt       DateTime?
  stripeSessionId String?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([referrerId, status])
  @@index([availableAt, status])
}

// Manual PayPal cash-out of promotional credit (min threshold). Admin pays offline.
model ReferralPayoutRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents  Int
  paypalEmail  String
  status       String    @default("pending")
  adminNote    String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?
  processedBy  String?

  @@index([status, createdAt])
  @@index([userId])
}

model TraderProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType        String   @default("personal")
  tradingStyle       String   @default("day")
  primaryMarkets     Json     @default("[]")
  propFirmPreset     String?
  dailyLossLimitPct  Float    @default(5)
  maxDrawdownPct     Float    @default(10)
  riskPerTradePct    Float    @default(1)
  maxTradesPerDay    Int      @default(10)
  profileComplete    Boolean  @default(false)
  strictPreTradeGate Boolean  @default(true)
  timezone           String   @default("America/New_York")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TradeJournalEntry {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol     String
  direction  String
  entryTime  DateTime
  exitTime   DateTime?
  pnl        Float?
  rMultiple  Float?
  session    String?
  setupType  String?
  notes      String?
  source     String    @default("manual")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, entryTime])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  active    Boolean  @default(true)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model ForumThread {
  id          String         @id @default(cuid())
  title       String
  topic       String
  description String?
  authorId    String
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pinned      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  messages    ForumMessage[]

  @@index([topic])
  @@index([updatedAt])
}

model OnboardingEmailLog {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  step   Int
  sentAt DateTime @default(now())

  @@unique([userId, step])
}

model PropFirmPlaybookProgress {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String    @default("not_started")
  currentDay    Int       @default(1)
  completedDays Json      @default("[]")
  startedAt     DateTime?
  completedAt   DateTime?
  lastActiveAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PlaybookEmailLog {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    Int
  sentAt DateTime @default(now())

  @@unique([userId, day])
}

model EngagementLead {
  id             String   @id @default(cuid())
  email          String   @unique
  viewedLessons  Json     @default("[]")
  source         String?
  abStickyBucket String?
  dripStep       Int      @default(0)
  lastDripAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  dripLogs       EngagementDripLog[]

  @@index([dripStep, lastDripAt])
}

model EngagementDripLog {
  id     String         @id @default(cuid())
  leadId String
  lead   EngagementLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  step   Int
  sentAt DateTime       @default(now())

  @@unique([leadId, step])
}

model ForumMessage {
  id        String      @id @default(cuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([threadId, createdAt])
}

model AdminBulkEmailCampaign {
  id              String   @id @default(cuid())
  subject         String
  bodyHtml        String
  audience        String
  recipientCount  Int      @default(0)
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  status          String   @default("pending")
  errors          Json     @default("[]")
  createdByEmail  String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?
}

model SupportInboundEmail {
  id              String   @id @default(cuid())
  resendEmailId   String   @unique
  messageId       String?
  fromAddress     String
  toAddresses     Json     @default("[]")
  subject         String
  textBody        String?
  htmlBody        String?
  receivedAt      DateTime @default(now())
  read            Boolean  @default(false)
  archived        Boolean  @default(false)
  repliedAt       DateTime?
  replyResendId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([receivedAt])
  @@index([read, archived])
}